filters:
  and:
    - file.inFolder("wiki")
    - file.ext == "md"
properties:
  note.type:
    displayName: Type
  note.status:
    displayName: Status
  note.confidence:
    displayName: Conf
  note.updated:
    displayName: Updated
views:
  - type: table
    name: All pages by type
    groupBy:
      property: note.type
      direction: ASC
    order:
      - file.name
      - note.status
      - note.confidence
      - note.updated
